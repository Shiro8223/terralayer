Keybinds: {
	ClassAbility.DisplayName: Class Ability
	OpenEstate.DisplayName: Open Estate
	DepthsMap.DisplayName: Depths Map
}

Conditions: {
	Floor1: After opening floor 1
	Floor2: After opening floor 2
	Floor3: After opening floor 3
	Floor4: After opening floor 4
	Floor5: After opening floor 5
}

Configs: {
	TerralayerConfig: {
		DisplayName: Terralayer Settings

		TollPercent: {
			Label: Gatekeeper toll (%)
			Tooltip: Share of the coins you carry that the Gatekeeper takes each time you descend. Coins in your safe are tolled at half this rate. Toll Relief lowers both.
		}

		PinnedLayoutExtraToll: {
			Label: Extra toll while the layout is pinned (%)
			Tooltip: Added to the toll while the Cartographer keeps the dungeon layout fixed.
		}

		DeathCoinLossPercent: {
			Label: Coins lost on death (%)
			Tooltip: Share of the coins you carry that is lost when an heir dies. The rest is kept for upgrades.
		}

		EnemyStrength: {
			Label: Depths enemy strength
			Tooltip: Multiplies the life and damage of enemies in the Depths.
		}

		GoldMultiplier: {
			Label: Gold multiplier
			Tooltip: Multiplies bonus gold from enemies, chests and rooms.
		}
	}
}

NPCs: {
	Steward: {
		DisplayName: Steward

		TownNPCMood: {
			Content: The estate is in order, and so am I.
			NoHome: A steward without an estate? Find me a room, please.
			FarFromHome: I'm a long way from home.
			DislikeCrowded: It's getting crowded around here.
			HateCrowded: Far too many people in this house!
			LoveSpace: Plenty of room. Lovely.
			LikeNPC_Princess: I like {NPCName}.
			Princess_LovesNPC: I like {NPCName}.
		}
	}

	Gatekeeper: {
		DisplayName: Gatekeeper

		TownNPCMood: {
			Content: Business is steady. People keep going down.
			NoHome: Even a gatekeeper needs a gate. Or at least a door.
			FarFromHome: I'm a long way from home.
			DislikeCrowded: It's getting crowded around here.
			HateCrowded: Far too many people in this house!
			LoveSpace: Plenty of room. Lovely.
